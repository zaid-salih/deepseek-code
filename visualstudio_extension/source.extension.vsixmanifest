<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
    <Metadata>
        <Identity Id="DeepSeekCode.a8b34b1f-7a2d-4e8a-9c3d-1e2f3a4b5c6d" Version="1.0" Language="en-US" Publisher="DeepSeek-Code" />
        <DisplayName>DeepSeek-Code</DisplayName>
